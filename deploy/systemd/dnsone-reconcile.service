[Unit]
Description=DNSOne: publish zones that are behind MySQL
After=network-online.target mysql.service named.service pdns-recursor.service
Wants=network-online.target

[Service]
Type=oneshot
User=dnsone
Group=dnsone
SupplementaryGroups=bind
EnvironmentFile=/etc/dnsone/dnsone.env
WorkingDirectory=/opt/dnsone/backend
ExecStart=/opt/dnsone/backend/.venv/bin/dnsone-ctl zones reconcile
TimeoutStartSec=600
UMask=0027
# Exit 75: another job held the lock; the next run catches up.
SuccessExitStatus=75
ProtectSystem=full
ReadWritePaths=/var/lib/bind/zones /etc/bind/dnsone /var/lib/dnsone /var/log/dnsone
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
