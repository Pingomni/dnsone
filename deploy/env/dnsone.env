# DNSOne settings. Installed as /etc/dnsone/dnsone.env (root:dnsone 0640).
# Only the CHANGE_ME values must be set; every other line shows the default.

DNSONE_DATABASE_URL=mysql+pymysql://dnsone:CHANGE_ME_DB_PASSWORD@127.0.0.1:3306/dnsone?charset=utf8mb4
# Shown in the UI and stored with statistics; one name per server (Phase 2).
DNSONE_NODE_NAME=dns1
# primary: publishes zones. replica (Phase 2): resolver only; its BIND is a secondary of the primary.
DNSONE_ROLE=primary
# The timezone the console shows times in (an IANA name, e.g. Europe/Tirane).
DNSONE_TIMEZONE=UTC

# Statistics and RPZ verification (must match recursor.conf api-key and dnsdist.conf apiKey).
DNSONE_RECURSOR_API_KEY=CHANGE_ME_RECURSOR_API_KEY
DNSONE_DNSDIST_API_KEY=CHANGE_ME_DNSDIST_API_KEY

# Sessions: the console is HTTPS-only, so cookies are Secure.
DNSONE_COOKIE_SECURE=1
DNSONE_SESSION_HOURS=12
DNSONE_LOGIN_MAX_FAILURES=5
DNSONE_LOGIN_LOCK_MINUTES=15

# BIND
DNSONE_ZONES_DIR=/var/lib/bind/zones
DNSONE_BIND_ZONES_CONF=/etc/bind/dnsone/zones.conf
DNSONE_NAMED_CONF=/etc/bind/named.conf
DNSONE_RNDC_KEY=/etc/bind/dnsone/dnsone-rndc.key
DNSONE_BIND_ADDRESS=127.0.0.1
DNSONE_BIND_PORT=5301
# DNSSEC: BIND keeps the keys of signed zones here (bind:bind 0750; in the nightly backup).
DNSONE_BIND_KEY_DIR=/var/lib/bind/keys

# PowerDNS Recursor
DNSONE_RECURSOR_FORWARD_ZONES_FILE=/var/lib/dnsone/recursor/forward-zones.conf
DNSONE_RECURSOR_NTA_FILE=/var/lib/dnsone/recursor/negative-trust-anchors.txt
DNSONE_REC_CONTROL="/usr/bin/sudo -n -u pdns /usr/bin/rec_control"
DNSONE_RECURSOR_API_URL=http://127.0.0.1:8082
# Generated for the policy script (/etc/powerdns/dnsone.lua) and allow-from-file (recursor.conf).
DNSONE_RECURSOR_POLICY_FILE=/var/lib/dnsone/recursor/policy.lua
DNSONE_RECURSOR_ALLOW_FROM_FILE=/var/lib/dnsone/recursor/allow-from.conf

# dnsdist
DNSONE_DNSDIST_AUTH_ZONES_FILE=/var/lib/dnsone/dnsdist/auth-zones.txt
DNSONE_DNSDIST_API_URL=http://127.0.0.1:8083
# Settings → DNS server, written for dnsdist.conf. The 1.0 file below is read once, as the initial
# customer networks, until the settings are saved in the console.
DNSONE_DNSDIST_SETTINGS_FILE=/var/lib/dnsone/dnsdist/settings.lua
DNSONE_CLIENT_NETWORKS_FILE=/etc/dnsone/client-networks.conf
# Phase 2: the catalog zone that lists hosted zones for BIND secondaries.
DNSONE_CATALOG_ZONE=catalog.dnsone

# RPZ
DNSONE_RPZ_FILE=/var/lib/dnsone/rpz/dnsone.rpz
DNSONE_BLOCKLIST_DIR=/var/lib/dnsone/blocklists
DNSONE_BLOCKLIST_MAX_BYTES=67108864
DNSONE_BLOCKLIST_TIMEOUT=60

# Query log (dnsone-querylog). full: query log + top lists; aggregate: top lists only (no
# per-client history); off: nothing collected. The query log is personal data: keep it short.
# Settings → Privacy can hide domains/clients and shorten (never lengthen) the retention below.
DNSONE_QUERYLOG_MODE=full
DNSONE_QUERYLOG_LISTEN=127.0.0.1:4242
DNSONE_QUERYLOG_RETENTION_HOURS=24
DNSONE_QUERYLOG_MAX_ROWS=20000000
DNSONE_QUERYLOG_IGNORE_CLIENTS=127.0.0.1,::1

# Logging (also to journald)
DNSONE_LOG_FILE=/var/log/dnsone/dnsone.log
DNSONE_LOG_LEVEL=INFO

# ALIAS records: resolvers for targets outside the hosted zones, comma-separated (empty: the
# system's /etc/resolv.conf). Do not point this at this server's own dnsdist address: it only
# answers its customers.
DNSONE_ALIAS_RESOLVERS=

# Dynamic DNS (dnsone-ddns): where dnsdist sends RFC 2136 updates (must match newServer "ddns"
# in dnsdist.conf). Turned on in Settings → DNS server.
DNSONE_DDNS_LISTEN=127.0.0.1:5302

# Software update (Settings → Overview): the console asks GitHub for the latest release (at most
# hourly). 0 turns that off; updates then need `sudo dnsone-update`.
#DNSONE_UPDATE_CHECK=1

# Licence registration (Settings → License): with a Pro key, the primary node tells your PingOmni account
# which server the licence runs on (the key, a hash of /etc/machine-id and the host name), then checks in
# twice a day. Report only: Pro never depends on it. Empty turns it off.
#DNSONE_ACCOUNT_URL=https://account.pingomni.com
