#!/bin/bash
# DNSOne sign-in mode, for one server (1.3, Keycloak installed). Run as root, from the release:
#
#     bash ops/dnsone-login-mode both gnezha    # username + password form, and "Sign in with SSO" below it;
#                                               # sets gnezha's DNSOne password (asked, typed twice)
#     bash ops/dnsone-login-mode sso            # only "Sign in with SSO"
#
# Also installs this release's code, the nginx snippet for Keycloak (/auth/) and the dnsone theme for
# Keycloak's sign-in pages (Keycloak restarts once), then restarts only
# the console API. DNS is not touched. An account can have a DNSOne password and a Keycloak link at
# once, and then signs in either way.
set -euo pipefail
umask 022
fail() { printf 'STOPPED: %s\n' "$*" >&2; exit 1; }
[ "$(id -u)" = 0 ] || fail "run as root"
MODE="${1:-}"
USER_NAME="${2:-}"
case "$MODE" in both) value=1 ;; sso) value=0 ;; *) fail "usage: $0 both USER | $0 sso" ;; esac
[ "$MODE" = sso ] || [ -n "$USER_NAME" ] || fail "give the user who gets a DNSOne password: $0 both USER"
SRC="$(cd "$(dirname "$0")/.." && pwd)"
[ "$(cat /opt/dnsone/VERSION)" = "1.3.0" ] && [ "$(cat "$SRC/VERSION")" = "1.3.0" ] || fail "needs DNSOne 1.3 installed and this 1.3 release"
[ -f "$SRC/frontend/dist/index.html" ] || fail "$SRC/frontend/dist is not built"

echo "== code and nginx"
stamp="$(date +%Y%m%d-%H%M%S)"
tar -czpf "/var/backups/dnsone/pre-login-mode-$stamp.tar.gz" -C / opt/dnsone etc/dnsone/dnsone.env etc/nginx/snippets/dnsone-keycloak.conf
chmod 0600 "/var/backups/dnsone/pre-login-mode-$stamp.tar.gz"
rsync -a --delete --exclude '/backend/.venv' --exclude '/frontend/node_modules' --exclude '__pycache__' \
      --exclude '.pytest_cache' --exclude '*.egg-info' --exclude '.git' --exclude '/.claude' "$SRC/" /opt/dnsone/
chown -R root:root /opt/dnsone
install -m 0644 /opt/dnsone/deploy/nginx/dnsone-keycloak.conf /etc/nginx/snippets/dnsone-keycloak.conf
nginx -t
systemctl reload nginx

echo "== Keycloak's sign-in pages in DNSOne's design (theme dnsone)"
rm -rf /opt/keycloak/themes/dnsone
cp -r /opt/dnsone/deploy/keycloak/themes/dnsone /opt/keycloak/themes/dnsone
chown -R keycloak:keycloak /opt/keycloak/themes/dnsone
systemctl restart keycloak
echo -n "waiting for Keycloak"
for _ in $(seq 150); do curl -fs -o /dev/null http://127.0.0.1:9000/auth/health/ready && break; echo -n .; sleep 2; done
echo
runuser -u dnsone -- /opt/dnsone/backend/.venv/bin/python -c \
    'from dnsone import kcadmin; kcadmin.update_realm({"loginTheme": "dnsone", "displayName": "DNSOne"}); print("realm uses the dnsone theme")'

echo "== sign-in mode: $MODE"
sed -i '/^DNSONE_LOCAL_LOGIN=/d' /etc/dnsone/dnsone.env
echo "DNSONE_LOCAL_LOGIN=$value" >> /etc/dnsone/dnsone.env
systemctl restart dnsone-api

if [ "$MODE" = both ]; then
    echo "== DNSOne password for $USER_NAME (12+ characters, typed twice)"
    dnsone-ctl create-admin "$USER_NAME" --role "${ROLE:-admin}"
fi

sleep 3
mode="$(curl -fsS --max-time 10 http://127.0.0.1:8100/api/auth/oidc)" || fail "the API does not answer"
echo "sign-in page: $mode"
echo "Done. Backup of the previous files: /var/backups/dnsone/pre-login-mode-$stamp.tar.gz"
