#!/bin/bash
# Publishes the DNSOne demo at https://demo-dns.pingomni.com (or DEMO_FQDN). Run as root, from the release:
#
#     bash ops/dnsone-demo-deploy
#
# Needs: the demo built (frontend/dist-demo: npm run build:demo) and the name pointing to this server
# (a DNS-only A record). It copies the demo to /var/www/demo-dns, gets a Let's Encrypt certificate
# (webroot, like the console's; certbot.timer renews it), installs the nginx site and checks it. Run it
# again after a new demo build: only the files are replaced. The real console and DNS are not touched.
set -euo pipefail
umask 022
fail() { printf 'STOPPED: %s\n' "$*" >&2; exit 1; }
[ "$(id -u)" = 0 ] || fail "run as root"
FQDN="${DEMO_FQDN:-demo-dns.pingomni.com}"
SRC="$(cd "$(dirname "$0")/.." && pwd)"
SITE=/etc/nginx/sites-available/dnsone-demo
CONSOLE=/etc/nginx/sites-available/dnsone

[ -f "$SRC/frontend/dist-demo/index.html" ] || fail "$SRC/frontend/dist-demo is not built (npm run build:demo)"
IP="$(grep -m1 -oP '^\s*listen\s+\K[0-9.]+(?=:443)' "$CONSOLE")" || fail "no listen address in $CONSOLE"
resolved="$(dig +short "$FQDN" @1.1.1.1 | tail -n1)"
[ "$resolved" = "$IP" ] || fail "$FQDN resolves to '${resolved:-nothing}', not $IP: add an A record $FQDN -> $IP (DNS only, not proxied) and wait a minute"

echo "== files: /var/www/demo-dns"
install -d -o root -g root -m 0755 /var/www/demo-dns
rsync -a --delete "$SRC/frontend/dist-demo/" /var/www/demo-dns/
chown -R root:root /var/www/demo-dns

echo "== nginx and certificate for $FQDN"
install -m 0644 "$SRC/deploy/nginx/dnsone-demo-headers.conf" /etc/nginx/snippets/dnsone-demo-headers.conf
if [ ! -f "/etc/letsencrypt/live/$FQDN/fullchain.pem" ]; then
    # Port 80 only, for the Let's Encrypt challenge; the full site follows once the certificate exists.
    sed -n '/^server {/,/^}/p' "$SRC/deploy/nginx/dnsone-demo.conf" | sed -n '1,/^}/p' \
        | sed -e "s#CHANGE_ME_IP#$IP#g" -e "s#CHANGE_ME_DEMO_FQDN#$FQDN#g" > "$SITE"
    ln -sf "$SITE" /etc/nginx/sites-enabled/dnsone-demo
    nginx -t && systemctl reload nginx
    certbot certonly --webroot -w /var/www/letsencrypt -d "$FQDN" --non-interactive --agree-tos \
        --register-unsafely-without-email --deploy-hook "systemctl reload nginx"
fi
sed -e "s#CHANGE_ME_IP#$IP#g" -e "s#CHANGE_ME_DEMO_FQDN#$FQDN#g" "$SRC/deploy/nginx/dnsone-demo.conf" > "$SITE"
ln -sf "$SITE" /etc/nginx/sites-enabled/dnsone-demo
nginx -t
systemctl reload nginx

echo "== check"
sleep 1
code="$(curl -s -o /dev/null -w '%{http_code}' "https://$FQDN/")"
asset="$(grep -oE '/assets/index-[^"]+\.js' /var/www/demo-dns/index.html | head -n1)"
acode="$(curl -s -o /dev/null -w '%{http_code}' "https://$FQDN$asset")"
api="$(curl -s -o /dev/null -w '%{http_code}' "https://$FQDN/api/auth/me")"
echo "page $code, script $acode, /api $api (404 expected: the demo answers it in the browser)"
[ "$code" = 200 ] && [ "$acode" = 200 ] || fail "the demo does not load"
echo "Done: https://$FQDN"
