#!/bin/bash
# DNSOne post-install: brings this server's system configuration in line with the installed release.
# Run as root by dnsone-update after every install (and on a run with nothing to install); safe to run
# again: every step checks first and changes nothing that is already right.
#
#     sudo bash /opt/dnsone/ops/dnsone-postinstall
#
#   - nginx: the console's security headers on every response (deploy/nginx/dnsone-headers.conf); the
#     site file is patched in place (certificates and local lines kept), checked with nginx -t, and put
#     back if the check fails
#   - installing updates from the console: the request and status directories, dnsone-update.path
#   - dnsdist: zone transfers through port 53 refused (1.4.5); checked with dnsdist --check-config, then
#     dnsdist restarts (a second or two without DNS); the previous file is put back if anything fails
#   - the firewall (1.5): its request and status directories, dnsone-firewall.path and the boot unit
#   - setting up the cluster from the console (1.5.6): its request and status directories, dnsone-cluster.path
#   - the Recursor's settings directory (1.5) and the sudoers rule that restarts it
set -euo pipefail
umask 022

log() { printf '== %s\n' "$*"; }
[ "$(id -u)" = 0 ] || { echo "run as root (sudo bash $0)" >&2; exit 1; }
REL=/opt/dnsone
SITE=/etc/nginx/sites-available/dnsone

# nginx: security headers in every location (1.4.4).
if [ -f "$SITE" ]; then
    install -m 0644 "$REL/deploy/nginx/dnsone-headers.conf" /etc/nginx/snippets/dnsone-headers.conf
    new="$(mktemp)"
    python3 "$REL/ops/postinstall-helper.py" nginx-headers "$SITE" > "$new"
    if cmp -s "$new" "$SITE"; then
        rm -f "$new"
    else
        log "nginx: security headers on the console page and its files"
        backup="$SITE.pre-$(cat "$REL/VERSION")"
        cp -p "$SITE" "$backup"
        install -m 0644 "$new" "$SITE"
        rm -f "$new"
        if nginx -t 2>/dev/null; then
            systemctl reload nginx
            echo "   nginx reloaded (the previous site file: $backup)"
        else
            install -m 0644 "$backup" "$SITE"
            echo "   nginx -t failed with the change; the site file is unchanged. Add the include by hand (docs/RUNBOOK.md)." >&2
            nginx -t || true
        fi
    fi
fi

# dnsdist: refuse zone transfers through port 53 (1.4.5). Up to 1.4.4 anyone could copy every hosted zone.
DD=/etc/dnsdist/dnsdist.conf
if [ -f "$DD" ]; then
    new="$(mktemp)"
    if python3 "$REL/ops/postinstall-helper.py" dnsdist-xfr "$DD" > "$new"; then
        if ! cmp -s "$new" "$DD"; then
            log "dnsdist: zone transfers through port 53 refused"
            backup="$DD.pre-$(cat "$REL/VERSION")"
            cp -p "$DD" "$backup"
            install -o root -g _dnsdist -m 0640 "$new" "$DD"
            if dnsdist --check-config -C "$DD" >/dev/null 2>&1 && systemctl restart dnsdist && sleep 2 && systemctl is-active --quiet dnsdist; then
                echo "   dnsdist restarted (the previous file: $backup)"
            else
                install -o root -g _dnsdist -m 0640 "$backup" "$DD"
                systemctl restart dnsdist || true
                echo "   the patched dnsdist.conf failed its check; the previous file is back. Add the rule by hand (docs/RUNBOOK.md)." >&2
            fi
        fi
    else
        echo "   dnsdist.conf was not changed (see above)." >&2
    fi
    rm -f "$new"
fi

# Installing from the console (1.4.2).
if [ -f "$REL/deploy/systemd/dnsone-update.path" ]; then
    install -d -o dnsone -g dnsone -m 0750 /var/lib/dnsone/update
    install -d -o root -g dnsone -m 0750 /var/lib/dnsone/update-status
    for unit in dnsone-update.path dnsone-update.service; do
        if ! cmp -s "$REL/deploy/systemd/$unit" "/etc/systemd/system/$unit"; then
            install -m 0644 "$REL/deploy/systemd/$unit" /etc/systemd/system/
            changed=1
        fi
    done
    [ "${changed:-0}" = 1 ] && systemctl daemon-reload
    if ! systemctl is-active --quiet dnsone-update.path; then
        systemctl enable --quiet --now dnsone-update.path
        log "installing updates from the console: on (Settings -> Overview -> Software update)"
    fi
fi

# The firewall (1.5): Settings -> Firewall leaves a request in /var/lib/dnsone/firewall, dnsone-firewall.path
# starts dnsone-firewall-apply.service (root); dnsone-firewall.service loads the confirmed rules at boot.
if [ -f "$REL/deploy/systemd/dnsone-firewall.path" ]; then
    install -d -o dnsone -g dnsone -m 0750 /var/lib/dnsone/firewall
    install -d -o root -g dnsone -m 0750 /var/lib/dnsone/firewall-status
    fw_changed=0
    for unit in dnsone-firewall.path dnsone-firewall-apply.service dnsone-firewall.service; do
        if ! cmp -s "$REL/deploy/systemd/$unit" "/etc/systemd/system/$unit"; then
            install -m 0644 "$REL/deploy/systemd/$unit" /etc/systemd/system/
            fw_changed=1
        fi
    done
    [ "$fw_changed" = 1 ] && systemctl daemon-reload
    systemctl is-enabled --quiet dnsone-firewall.service 2>/dev/null || systemctl enable --quiet dnsone-firewall.service
    if ! systemctl is-active --quiet dnsone-firewall.path; then
        systemctl enable --quiet --now dnsone-firewall.path
        log "firewall from the console: ready (Settings -> Firewall; off until you turn it on)"
    fi
fi

# The cluster (1.5.6): Settings -> Cluster leaves a request in /var/lib/dnsone/cluster, dnsone-cluster.path
# starts dnsone-cluster.service (root), which adds, joins, leaves or removes a server.
if [ -f "$REL/deploy/systemd/dnsone-cluster.path" ]; then
    install -d -o dnsone -g dnsone -m 0750 /var/lib/dnsone/cluster
    install -d -o root -g dnsone -m 0750 /var/lib/dnsone/cluster-status
    cl_changed=0
    for unit in dnsone-cluster.path dnsone-cluster.service; do
        if ! cmp -s "$REL/deploy/systemd/$unit" "/etc/systemd/system/$unit"; then
            install -m 0644 "$REL/deploy/systemd/$unit" /etc/systemd/system/
            cl_changed=1
        fi
    done
    [ "$cl_changed" = 1 ] && systemctl daemon-reload
    if ! systemctl is-active --quiet dnsone-cluster.path; then
        systemctl enable --quiet --now dnsone-cluster.path
        log "cluster from the console: ready (Settings -> Cluster)"
    fi
fi

# Settings -> DNS server -> Resolver (1.5): the directory recursor.conf's include-dir reads, and the
# sudoers rule that lets DNSOne restart the Recursor when those settings change.
if [ -d /var/lib/dnsone/recursor ]; then
    install -d -o dnsone -g dnsone -m 0755 /var/lib/dnsone/recursor/conf.d
fi
if [ -d /etc/sudoers.d ] && ! cmp -s "$REL/deploy/sudoers/dnsone" /etc/sudoers.d/dnsone; then
    if visudo -cf "$REL/deploy/sudoers/dnsone" >/dev/null; then
        install -m 0440 "$REL/deploy/sudoers/dnsone" /etc/sudoers.d/dnsone
        log "sudoers: DNSOne may restart the Recursor (resolver settings)"
    else
        echo "   visudo rejected deploy/sudoers/dnsone; /etc/sudoers.d/dnsone is unchanged." >&2
    fi
fi
