#!/bin/bash
# Keycloak realm for DNSOne single sign-on: the realm, DNSOne's roles, the "dnsone" client (sign-in)
# and the "dnsone-admin-api" service account DNSOne manages users and realm settings with.
# Safe to run again: what exists is kept (the client's redirect URIs are brought up to date).
#
#   KC_URL=http://127.0.0.1:8180/auth KC_ADMIN_USER=admin KC_ADMIN_PASSWORD=… \
#   PUBLIC_URL=https://dns.example SECRET_FILE=/root/dnsone-oidc-secret ADMIN_SECRET_FILE=/root/dnsone-kcadmin-secret \
#   [REALM=pingomni] [SSO_ADMIN=alice SSO_ADMIN_PASSWORD=…] [KCADM=/opt/keycloak/bin/kcadm.sh] \
#   bash ops/keycloak-realm
#
# SSO_ADMIN: also create that Keycloak user with the dnsone-admin role and a temporary password
# (changed at the first sign-in). Otherwise add users in Keycloak's admin console (/auth/admin).
set -euo pipefail
: "${KC_URL:?}" "${KC_ADMIN_USER:?}" "${KC_ADMIN_PASSWORD:?}" "${PUBLIC_URL:?}" "${SECRET_FILE:?}" "${ADMIN_SECRET_FILE:?}"
REALM="${REALM:-pingomni}"
CLIENT="${CLIENT_ID:-dnsone}"
KCADM="${KCADM:-/opt/keycloak/bin/kcadm.sh}"
export KCADM_CONFIG="${KCADM_CONFIG:-$(mktemp)}"
trap 'rm -f "$KCADM_CONFIG"' EXIT
kc() { "$KCADM" "$@" --config "$KCADM_CONFIG"; }

kc config credentials --server "$KC_URL" --realm master --user "$KC_ADMIN_USER" --password "$KC_ADMIN_PASSWORD" >/dev/null

if ! kc get "realms/$REALM" >/dev/null 2>&1; then
    # Brute-force protection on; sessions like the console's (12 h).
    kc create realms -s realm="$REALM" -s enabled=true -s displayName="Pingomni" -s bruteForceProtected=true \
        -s ssoSessionMaxLifespan=43200 -s loginWithEmailAllowed=true >/dev/null
    echo "realm $REALM created"
fi

# DNSOne's look on Keycloak's sign-in pages: the "dnsone" theme (deploy/keycloak/themes, copied to
# /opt/keycloak/themes before this runs). LOGIN_THEME=keycloak.v2 keeps Keycloak's own look.
kc update "realms/$REALM" -s loginTheme="${LOGIN_THEME:-dnsone}" -s displayName=DNSOne

for spec in "dnsone-admin:DNSOne administrator: everything, including users and settings" \
            "dnsone-operator:DNSOne operator: zones, records, blocklists and rules" \
            "dnsone-viewer:DNSOne viewer: read-only"; do
    name="${spec%%:*}"
    if ! kc get "roles/$name" -r "$REALM" >/dev/null 2>&1; then
        kc create roles -r "$REALM" -s name="$name" -s description="${spec#*:}" >/dev/null
        echo "role $name created"
    fi
done

callback="$PUBLIC_URL/api/auth/oidc/callback"
id="$(kc get clients -r "$REALM" -q clientId="$CLIENT" --fields id --format csv --noquotes | sed -n 1p)"
settings=(-s enabled=true -s protocol=openid-connect -s publicClient=false -s standardFlowEnabled=true
          -s directAccessGrantsEnabled=false -s implicitFlowEnabled=false -s serviceAccountsEnabled=false
          -s "redirectUris=[\"$callback\"]" -s "webOrigins=[\"$PUBLIC_URL\"]" -s "rootUrl=$PUBLIC_URL" -s "name=DNSOne"
          -s 'attributes."pkce.code.challenge.method"=S256' -s "attributes.\"post.logout.redirect.uris\"=$PUBLIC_URL/")
if [ -z "$id" ]; then
    id="$(kc create clients -r "$REALM" -s clientId="$CLIENT" "${settings[@]}" -i)"
    echo "client $CLIENT created"
else
    kc update "clients/$id" -r "$REALM" "${settings[@]}"
    echo "client $CLIENT updated"
fi
umask 077
kc get "clients/$id/client-secret" -r "$REALM" --fields value --format csv --noquotes > "$SECRET_FILE"
echo "client secret written to $SECRET_FILE"

# DNSOne's own access to Keycloak's admin API (Settings -> Single sign-on): a service account with
# the realm-management roles for users, realm settings, events and sign-in providers, nothing more.
ADMIN_CLIENT=dnsone-admin-api
aid="$(kc get clients -r "$REALM" -q clientId="$ADMIN_CLIENT" --fields id --format csv --noquotes | sed -n 1p)"
if [ -z "$aid" ]; then
    aid="$(kc create clients -r "$REALM" -s clientId="$ADMIN_CLIENT" -s name="DNSOne administration" -s enabled=true \
        -s protocol=openid-connect -s publicClient=false -s serviceAccountsEnabled=true -s standardFlowEnabled=false \
        -s directAccessGrantsEnabled=false -s implicitFlowEnabled=false -i)"
    echo "client $ADMIN_CLIENT created"
fi
kc add-roles -r "$REALM" --uusername "service-account-$ADMIN_CLIENT" --cclientid realm-management \
    --rolename manage-users --rolename view-users --rolename query-users --rolename query-groups \
    --rolename manage-realm --rolename view-realm --rolename manage-events --rolename view-events \
    --rolename manage-identity-providers --rolename view-identity-providers --rolename view-clients --rolename query-clients
(umask 077; kc get "clients/$aid/client-secret" -r "$REALM" --fields value --format csv --noquotes > "$ADMIN_SECRET_FILE")
echo "admin API secret written to $ADMIN_SECRET_FILE"

# Sign-in events kept for 90 days (Settings -> Single sign-on -> Events).
kc update events/config -r "$REALM" -s eventsEnabled=true -s eventsExpiration=7776000 -s adminEventsEnabled=true

if [ -n "${SSO_ADMIN:-}" ]; then
    if [ -z "$(kc get users -r "$REALM" -q username="$SSO_ADMIN" -q exact=true --fields id --format csv --noquotes)" ]; then
        : "${SSO_ADMIN_PASSWORD:?set SSO_ADMIN_PASSWORD for $SSO_ADMIN}"
        kc create users -r "$REALM" -s username="$SSO_ADMIN" -s enabled=true -s emailVerified=true \
            -s "email=${SSO_ADMIN_EMAIL:-}" -s "firstName=${SSO_ADMIN_FIRST:-$SSO_ADMIN}" -s "lastName=${SSO_ADMIN_LAST:-Admin}" >/dev/null
        # Temporary unless SSO_ADMIN_PERMANENT is set: Keycloak asks for a new one at the first sign-in.
        temporary=(--temporary)
        [ -z "${SSO_ADMIN_PERMANENT:-}" ] || temporary=()
        kc set-password -r "$REALM" --username "$SSO_ADMIN" --new-password "$SSO_ADMIN_PASSWORD" "${temporary[@]}"
        echo "user $SSO_ADMIN created${temporary[*]:+ (temporary password: changed at the first sign-in)}"
    fi
    kc add-roles -r "$REALM" --uusername "$SSO_ADMIN" --rolename dnsone-admin
    echo "user $SSO_ADMIN has dnsone-admin"
fi
echo "issuer (DNSONE_OIDC_ISSUER): $PUBLIC_URL/auth/realms/$REALM"
